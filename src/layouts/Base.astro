---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import defaultOg from '../assets/products/sistemas-elevables.png';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** Si es true, el título se usa tal cual (portada). */
  rawTitle?: boolean;
  ogImage?: ImageMetadata;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
}

const { title, description, rawTitle = false, ogImage = defaultOg, noindex = false, breadcrumbs, jsonLd = [] } = Astro.props;

const fullTitle = rawTitle ? title : `${title} | ${site.name}`;
// STAGING=1 en la compilación: toda la web queda fuera de los buscadores (vista previa)
const staging = process.env.STAGING === '1';
const robots = noindex || staging ? 'noindex, follow' : null;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;

const structured: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs && breadcrumbs.length > 1) {
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, Astro.site).href,
    })),
  });
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#14202e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
