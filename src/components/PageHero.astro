---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Crumb } from '../layouts/Base.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  breadcrumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  /** Versión compacta para páginas legales y utilitarias */
  compact?: boolean;
}

const { title, eyebrow, lead, breadcrumbs = [], image, imageAlt = '', imageCaption, compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--image': image, 'page-hero--compact': compact }]}>
  <div class="container page-hero__inner">
    <div class="page-hero__text">
      {
        breadcrumbs.length > 1 && (
          <nav class="crumbs" aria-label="Migas de pan">
            <ol>
              {breadcrumbs.map((c, i) => (
                <li>{i < breadcrumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <figure class="page-hero__media">
          <div class="page-hero__img">
            <Image src={image} alt={imageAlt} widths={[480, 765, 1120].filter((w) => w <= image.width)} sizes="(max-width: 62rem) 100vw, 560px" loading="eager" fetchpriority="high" />
          </div>
          {imageCaption && <figcaption>{imageCaption}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    color: var(--c-white);
    background:
      radial-gradient(60rem 30rem at 90% 0%, rgb(11 78 162 / 0.26), transparent 60%),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 6rem 100%,
      var(--c-ink-deep);
  }
  .page-hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .page-hero--image .page-hero__inner {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }
  .page-hero--compact .page-hero__inner {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .page-hero__text {
    display: grid;
    gap: var(--s-4);
    align-content: center;
  }
  .page-hero .eyebrow {
    color: #c9d2dc;
  }
  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
    max-width: 18ch;
  }
  .page-hero--compact h1 {
    font-size: var(--fs-3xl);
  }
  .page-hero__lead {
    max-width: 40rem;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: #c9d2dc;
  }
  .page-hero :global(a:not(.btn)) {
    color: var(--c-white);
  }

  .page-hero__media {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }
  .page-hero__img {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
    aspect-ratio: 765 / 374;
  }
  .page-hero__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero__media figcaption {
    font-size: var(--fs-xs);
    color: #9eabb8;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    list-style: none;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: #9eabb8;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .crumbs li + li::before {
    content: '/';
    color: #5b6775;
  }
  .crumbs a {
    color: #c9d2dc !important;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--c-white) !important;
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--c-white);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-hero__text > * {
      animation: ph-rise 0.8s var(--ease-out) both;
    }
    .page-hero__text > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .page-hero__text > :nth-child(3) {
      animation-delay: 0.12s;
    }
    .page-hero__text > :nth-child(n + 4) {
      animation-delay: 0.18s;
    }
    .page-hero__img img {
      animation: ph-settle 1.4s var(--ease-out) both;
    }
  }
  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes ph-settle {
    from {
      transform: scale(1.07);
    }
  }

  @media (max-width: 62rem) {
    .page-hero--image .page-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
