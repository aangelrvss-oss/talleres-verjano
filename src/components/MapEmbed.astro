---
import Icon from './Icon.astro';
import { site, fullAddress } from '../data/site';
---

<div class="map" data-map>
  <div class="map__placeholder" data-map-placeholder>
    <Icon name="pin" size={32} />
    <p class="map__address">{fullAddress}</p>
    <p class="map__privacy">
      El mapa se carga desde Google Maps. Al mostrarlo, Google puede recoger datos de su navegación.
    </p>
    <div class="map__actions">
      <button class="btn btn--light" type="button" data-map-load>Mostrar mapa</button>
      <a class="btn btn--outline-light" href={site.mapsUrl} target="_blank" rel="noopener">
        Abrir en Google Maps
        <Icon name="external" size={16} />
        <span class="visually-hidden">(pestaña nueva)</span>
      </a>
    </div>
  </div>
  <template data-map-template>
    <iframe
      title={`Mapa de ubicación de ${site.name}`}
      src={site.mapsEmbedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </template>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const btn = map.querySelector<HTMLButtonElement>('[data-map-load]');
    const tpl = map.querySelector<HTMLTemplateElement>('[data-map-template]');
    btn?.addEventListener('click', () => {
      if (!tpl) return;
      map.querySelector('[data-map-placeholder]')?.remove();
      map.append(tpl.content.cloneNode(true));
      map.querySelector('iframe')?.focus();
    });
  });
</script>

<style>
  .map {
    position: relative;
    min-height: 22rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      var(--c-ink);
    color: var(--c-white);
  }
  .map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-6);
    text-align: center;
  }
  .map__placeholder :global(svg) {
    color: #ff8a8d;
  }
  .map__address {
    font-weight: 750;
    font-size: var(--fs-lg);
  }
  .map__privacy {
    max-width: 30rem;
    font-size: var(--fs-sm);
    color: #c9d2dc;
  }
  .map__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
