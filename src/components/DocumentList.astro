---
import Icon from './Icon.astro';
import type { TechDocument } from '../data/catalog';

interface Props {
  documents: TechDocument[];
}

const { documents } = Astro.props;
---

<section class="docs" aria-labelledby="docs-title">
  <h2 id="docs-title">Documentación técnica</h2>
  <p class="docs__note">Catálogos y fichas del fabricante en PDF.</p>
  <ul>
    {
      documents.map((d) => (
        <li>
          <a href={d.href} target="_blank" rel="noopener" type="application/pdf">
            <Icon name="file" size={20} />
            <span>
              {d.label}
              <span class="visually-hidden"> (PDF, se abre en una pestaña nueva)</span>
            </span>
            <span class="docs__type" aria-hidden="true">PDF</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .docs {
    display: grid;
    gap: var(--s-3);
  }
  h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    letter-spacing: -0.02em;
  }
  .docs__note {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    min-height: 3.75rem;
    padding: 0.75rem var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: 10px;
    background: var(--c-white);
    color: var(--c-ink);
    font-weight: 700;
    font-size: var(--fs-sm);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  a:hover {
    border-color: var(--c-ink);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  a :global(svg) {
    color: var(--c-brand);
  }
  .docs__type {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--c-muted);
  }
</style>
