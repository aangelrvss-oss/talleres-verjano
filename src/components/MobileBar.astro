---
/**
 * Barra de contacto fija en móvil. Para no tapar lo que se está leyendo
 * (tablas, documentación), se oculta mientras se desplaza hacia abajo y
 * vuelve al subir o al llegar al final de la página. También se oculta con el
 * formulario de presupuesto en pantalla y mientras se escribe en un campo.
 * El pie reserva su altura en móvil (ver Footer).
 */
import Icon from './Icon.astro';
import { primaryPhone } from '../data/site';
---

<div class="mbar" data-mbar aria-label="Contacto rápido" role="region">
  <a class="mbar__btn mbar__btn--call" href={primaryPhone.href}>
    <Icon name="phone" size={20} />
    <span>Llamar</span>
  </a>
  <a class="mbar__btn mbar__btn--quote" href="/contacto/#presupuesto">
    <span>Pedir presupuesto</span>
    <Icon name="arrow" size={18} />
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const form = document.getElementById('presupuesto');
  let formVisible = false;
  let typing = false;
  let goingDown = false;
  let lastY = window.scrollY;
  let ticking = false;
  const update = () => {
    ticking = false;
    const y = window.scrollY;
    // Umbral para no reaccionar a pequeños movimientos del dedo
    if (Math.abs(y - lastY) > 8) {
      goingDown = y > lastY;
      lastY = y;
    }
    const nearEnd = window.innerHeight + y >= document.documentElement.scrollHeight - 160;
    bar?.classList.toggle('is-visible', y > 320 && !formVisible && !typing && (!goingDown || nearEnd));
  };
  const schedule = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  if (form && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      formVisible = e.isIntersecting;
      update();
    }).observe(form);
  }
  // Con el teclado virtual abierto, la barra solo restaría espacio
  const isTextField = (el: EventTarget | null) =>
    el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement || (el instanceof HTMLInputElement && !['checkbox', 'radio', 'submit', 'button'].includes(el.type));
  document.addEventListener('focusin', (e) => {
    typing = isTextField(e.target);
    update();
  });
  document.addEventListener('focusout', () => {
    typing = false;
    update();
  });
  update();
  window.addEventListener('scroll', schedule, { passive: true });
</script>

<style>
  .mbar {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .mbar {
      position: fixed;
      left: 0.625rem;
      right: 0.625rem;
      /* Respeta el área segura inferior (iPhone) sin sumar dos márgenes */
      bottom: max(0.625rem, env(safe-area-inset-bottom));
      z-index: 45;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.375rem;
      padding: 0.3125rem;
      background: rgb(13 22 32 / 0.94);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-radius: 14px;
      box-shadow: var(--shadow-lg);
      transform: translateY(calc(100% + 1.5rem + env(safe-area-inset-bottom)));
      visibility: hidden;
      transition:
        transform var(--dur-panel) var(--ease-out),
        visibility 0s linear var(--dur-panel);
    }
    .mbar.is-visible {
      transform: none;
      visibility: visible;
      transition:
        transform var(--dur-panel) var(--ease-out),
        visibility 0s;
    }
    .mbar__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      /* 44 px: tamaño mínimo cómodo para el dedo */
      min-height: 2.75rem;
      padding: 0 1rem;
      border-radius: 10px;
      font-weight: 750;
      font-size: var(--fs-sm);
      white-space: nowrap;
      text-decoration: none;
    }
    .mbar__btn--call {
      color: var(--c-white);
      background: rgb(255 255 255 / 0.1);
    }
    .mbar__btn--quote {
      color: var(--c-white);
      background: var(--c-brand);
    }
  }
  /* 320 px: se ajusta el relleno para que «Pedir presupuesto» quepa en una línea */
  @media (max-width: 22.5rem) {
    .mbar__btn {
      gap: 0.375rem;
      padding: 0 0.75rem;
    }
  }
  @media (max-width: 47.99rem) and (prefers-reduced-motion: reduce) {
    .mbar {
      transition: none;
    }
  }
</style>
