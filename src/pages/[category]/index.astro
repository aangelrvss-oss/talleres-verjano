---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import CategorySwitch from '../../components/CategorySwitch.astro';
import { categories, productsIn, categoryUrl, getCategoryImage, type Category } from '../../data/catalog';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const items = productsIn(category.slug);
const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: category.name, href: categoryUrl(category.slug) },
];
---

<Base title={category.metaTitle} description={category.metaDescription} ogImage={getCategoryImage(category.slug)} breadcrumbs={breadcrumbs}>
  <PageHero
    title={category.name}
    eyebrow={`Catálogo · ${items.length} ${category.slug === 'sistemas-aluminio' ? 'sistemas' : 'productos'}`}
    lead={category.intro}
    breadcrumbs={breadcrumbs}
    image={getCategoryImage(category.slug)}
    imageCaption="Imagen ilustrativa."
  />

  <CategorySwitch current={category.slug} />

  <section class="section" aria-label={`Productos de ${category.name.toLowerCase()}`}>
    <div class="container">
      <div class="grid grid--3">
        {items.map((p, i) => <ProductCard product={p} headingLevel="h2" eager={i < 3} delay={i % 3} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
