---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import RptDiagram from '../components/RptDiagram.astro';
import { categories, productsIn, productUrl, categoryUrl, getProduct, getCategoryImage } from '../data/catalog';
import { guides } from '../data/guides';
import { site, primaryPhone, primaryEmail, fullAddress, experience } from '../data/site';
import { localBusiness } from '../data/schema';
import heroImg from '../assets/stock/fachada-ventanas-aluminio.jpg';
import patioImg from '../assets/stock/patio-corredera-moderna.jpg';

const featured = ['abatibles', 'correderas', 'elevables', 'muro-cortina', 'vidrios-acristalamientos', 'persianas-compactos'].map(
  (s) => getProduct(s)!,
);

const [aluminio, materiales, otros] = categories;

const steps = [
  { title: 'Asesoramiento', text: 'Nos cuenta qué necesita y le aconsejamos el sistema de apertura, la serie de perfil y el vidrio más adecuados para su hueco.' },
  { title: 'Presupuesto sin compromiso', text: 'Le preparamos un presupuesto con la solución elegida para que decida con toda la información.' },
  { title: 'Fabricación a medida', text: 'Fabricamos la carpintería con controles exhaustivos, con los mejores materiales y acabados.' },
  { title: 'Instalación', text: 'Nuestro equipo realiza el montaje y le deja la ventana, la puerta o el cerramiento listos para usar.' },
];

const values = [
  { icon: 'calendar', title: experience.short, text: experience.text },
  { icon: 'leaf', title: 'Ahorro energético', text: 'Le asesoramos para combinar carpinterías y vidrios de altas prestaciones y conseguir un mayor ahorro.' },
  { icon: 'shield', title: 'Calidad en cada detalle', text: 'Cuidamos al máximo la fabricación, con controles exhaustivos y los mejores materiales y acabados.' },
] as const;

const brands = [
  { name: 'QSystems', what: 'Perfiles de aluminio', href: '/sistemas-aluminio/' },
  { name: 'SGG Climalit', what: 'Vidrio y doble acristalamiento', href: '/materiales-adicionales/vidrios-acristalamientos/' },
  { name: 'Cherubini', what: 'Motores y automatismos', href: '/materiales-adicionales/domotica-automatismos/' },
  { name: 'Kassandra', what: 'Mamparas de baño', href: '/otros-productos/mamparas-bano/' },
];
---

<Base
  title="Talleres Verjano | Ventanas y carpintería de aluminio en Madrid"
  rawTitle
  description="Fabricantes e instaladores de ventanas, puertas y cerramientos de aluminio en Madrid. Sistemas con rotura de puente térmico, vidrios, persianas y protección solar."
  ogImage={heroImg}
  jsonLd={[localBusiness]}
>
  <!-- ───────────── Hero ───────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid container">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">Carpintería de aluminio · Madrid</p>
        <h1 id="hero-title" class="display hero__title">
          Ventanas y cerramientos de aluminio <span class="hero__accent">a medida</span>
        </h1>
        <p class="hero__lead">
          Fabricamos e instalamos ventanas, puertas y fachadas de aluminio con rotura de puente térmico, y las completamos con vidrios, persianas y
          protección solar. Le asesoramos sin compromiso.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="/contacto/#presupuesto">
            Pedir presupuesto <Icon name="arrow" size={18} class="btn__arrow" />
          </a>
          <a class="btn btn--outline-light btn--lg" href="#catalogo">Ver productos</a>
        </div>
        <p class="hero__call">
          o llámenos al <a href={primaryPhone.href}>{primaryPhone.display}</a>
        </p>
      </div>

      <div class="hero__media">
        <div class="hero__img">
          <Image
            src={heroImg}
            alt="Fachada con ventanas de aluminio proyectantes abiertas, iluminadas por la luz cálida del interior"
            widths={[480, 760, 1000, 1274]}
            sizes="(max-width: 62rem) 100vw, 46vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="hero__fact hero__fact--a">
          <span class="num">62 mm</span>
          <span>de vidrio máximo en las series abatibles con RPT</span>
        </p>
        <p class="hero__fact hero__fact--b">
          <span class="num">400 kg</span>
          <span>por hoja en correderas elevables</span>
        </p>
        <p class="hero__credit">Imagen ilustrativa</p>
      </div>
    </div>

    <nav class="hero__quick container" aria-label="Acceso rápido al catálogo">
      {
        categories.map((c, i) => (
          <a class="quick" href={categoryUrl(c.slug)} style={`--i:${i}`}>
            <span class="quick__n num">0{i + 1}</span>
            <span class="quick__name">{c.name}</span>
            <span class="quick__count">{productsIn(c.slug).length} productos</span>
            <Icon name="arrow" size={18} class="quick__arrow" />
          </a>
        ))
      }
    </nav>
  </section>

  <!-- ───────────── Catálogo ───────────── -->
  <section class="section catalog" id="catalogo" aria-labelledby="catalogo-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div data-reveal>
          <p class="eyebrow">Catálogo</p>
          <h2 id="catalogo-title" class="h-xl">Una solución para cada hueco</h2>
        </div>
        <p class="catalog__intro" data-reveal style="--d:1">
          Quince familias de producto en tres líneas. Cada ficha reúne la información técnica y, cuando existe, la documentación del fabricante.
        </p>
      </div>

      <div class="bento">
        <article class="tile tile--lg zoom-trigger" data-reveal>
          <div class="tile__media zoom-wrap">
            <Image
              src={patioImg}
              alt=""
              widths={[600, 900, 1300]}
              sizes="(max-width: 62rem) 100vw, 60vw"
            />
          </div>
          <div class="tile__body">
            <p class="tile__count">{productsIn(aluminio.slug).length} sistemas</p>
            <h3 class="tile__title"><a href={categoryUrl(aluminio.slug)}>{aluminio.name}</a></h3>
            <p class="tile__text">{aluminio.intro}</p>
            <ul class="tile__chips" aria-label={`Productos de ${aluminio.name.toLowerCase()}`}>
              {productsIn(aluminio.slug).map((p) => <li><a href={productUrl(p)}>{p.name}</a></li>)}
            </ul>
          </div>
        </article>

        {
          [materiales, otros].map((c, i) => (
            <article class="tile zoom-trigger" data-reveal style={`--d:${i + 1}`}>
              <div class="tile__media zoom-wrap">
                <Image src={getCategoryImage(c.slug)} alt="" widths={[400, 600, 765]} sizes="(max-width: 62rem) 100vw, 38vw" />
              </div>
              <div class="tile__body">
                <p class="tile__count">{productsIn(c.slug).length} productos</p>
                <h3 class="tile__title"><a href={categoryUrl(c.slug)}>{c.name}</a></h3>
                <ul class="tile__chips" aria-label={`Productos de ${c.name.toLowerCase()}`}>
                  {productsIn(c.slug).map((p) => <li><a href={productUrl(p)}>{p.name}</a></li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Banda técnica: RPT ───────────── -->
  <section class="section section--ink tech" aria-labelledby="tech-title">
    <div class="container tech__grid">
      <div class="tech__text">
        <p class="eyebrow" data-reveal>Ahorro energético</p>
        <h2 id="tech-title" class="h-xl" data-reveal style="--d:1">El aislamiento empieza en el perfil</h2>
        <p class="lead" data-reveal style="--d:2">
          En los perfiles con rotura de puente térmico, unas pletinas de poliamida separan el aluminio exterior del interior y actúan como barrera: frenan la
          transmisión de frío y calor y limitan la condensación.
        </p>
        <ul class="tech__facts">
          <li data-reveal style="--d:3"><span class="num">≤ 60 %</span><span>de ahorro energético con perfiles RPT</span></li>
          <li data-reveal style="--d:4"><span class="num">3</span><span>juntas de estanqueidad en los sistemas abatibles</span></li>
          <li data-reveal style="--d:5"><span class="num">62 mm</span><span>de vidrio en las series de 80 mm</span></li>
        </ul>
        <a class="link-arrow link-arrow--light" href="/consejos/rotura-puente-termico/" data-reveal style="--d:6">
          Qué es la rotura de puente térmico <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="tech__diagram">
        <RptDiagram />
      </div>
    </div>
  </section>

  <!-- ───────────── Destacados ───────────── -->
  <section class="section" aria-labelledby="destacados-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div data-reveal>
          <p class="eyebrow">Destacados</p>
          <h2 id="destacados-title" class="h-xl">Sistemas destacados del catálogo</h2>
        </div>
        <a class="link-arrow" href="/sistemas-aluminio/" data-reveal style="--d:1">Todos los sistemas de aluminio <Icon name="arrow" size={18} /></a>
      </div>
      <div class="rail">
        {featured.map((p, i) => <ProductCard product={p} showCategory delay={i % 3} />)}
      </div>
    </div>
  </section>

  <!-- ───────────── Cómo trabajamos ───────────── -->
  <section class="section section--surface process" aria-labelledby="proceso-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 id="proceso-title" class="h-xl">Del primer contacto a la instalación</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i}`}>
              <span class="step__n num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="values">
        {
          values.map((v, i) => (
            <div class="value" data-reveal style={`--d:${i}`}>
              <span class="value__icon">
                <Icon name={v.icon} size={22} />
              </span>
              <div>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Fabricantes ───────────── -->
  <section class="section brands" aria-labelledby="marcas-title">
    <div class="container brands__grid">
      <div data-reveal>
        <p class="eyebrow">Fabricantes</p>
        <h2 id="marcas-title" class="h-xl">Trabajamos con fabricantes de referencia</h2>
        <p class="brands__text">Seleccionamos perfiles, vidrios y mecanismos de marcas reconocidas y le explicamos las diferencias entre series.</p>
      </div>
      <ul class="brands__list">
        {
          brands.map((b, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a href={b.href}>
                <span class="brands__name">{b.name}</span>
                <span class="brands__what">{b.what}</span>
                <Icon name="arrow" size={18} class="brands__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── Consejos ───────────── -->
  <section class="section section--surface" aria-labelledby="consejos-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div data-reveal>
          <p class="eyebrow">Consejos</p>
          <h2 id="consejos-title" class="h-xl">Antes de cambiar sus ventanas</h2>
        </div>
        <a class="link-arrow" href="/consejos/" data-reveal style="--d:1">Ver todos los consejos <Icon name="arrow" size={18} /></a>
      </div>
      <div class="guides">
        {
          guides.map((g, i) => (
            <article class="guide" data-reveal style={`--d:${i}`}>
              <span class="guide__n num">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                <a href={`/consejos/${g.slug}/`}>{g.title}</a>
              </h3>
              <p>{g.excerpt}</p>
              <span class="guide__more" aria-hidden="true">
                Leer guía <Icon name="arrow" size={16} />
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Presupuesto ───────────── -->
  <section class="quote-band" aria-labelledby="quote-title">
    <div class="container quote-band__inner">
      <div data-reveal>
        <p class="eyebrow">Presupuesto sin compromiso</p>
        <h2 id="quote-title" class="display quote-band__title">¿Hablamos de su proyecto?</h2>
      </div>
      <div class="quote-band__side" data-reveal style="--d:1">
        <p>Cuéntenos medidas y necesidades y le asesoramos sobre el sistema, el vidrio y los complementos que mejor se adaptan a su vivienda o local.</p>
        <div class="quote-band__actions">
          <a class="btn btn--primary btn--lg" href="/contacto/#presupuesto">
            Pedir presupuesto <Icon name="arrow" size={18} class="btn__arrow" />
          </a>
          <a class="btn btn--outline-light btn--lg" href={primaryPhone.href}>
            <Icon name="phone" size={18} />
            {primaryPhone.display}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Visítenos ───────────── -->
  <section class="section visit" aria-labelledby="visitenos-title">
    <div class="container visit__grid">
      <div class="visit__text" data-reveal>
        <p class="eyebrow">Contacto</p>
        <h2 id="visitenos-title" class="h-xl">Visite nuestra exposición y fábrica</h2>
        <ul class="visit__list">
          <li>
            <Icon name="pin" size={20} />
            <span>{fullAddress} <span class="visit__muted">({site.address.district})</span></span>
          </li>
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={20} />
                <a href={p.href}>
                  {p.display} <span class="visit__muted">· {p.label.toLowerCase()}</span>
                </a>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={20} />
            <a href={`mailto:${primaryEmail.address}`}>{primaryEmail.address}</a>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <span>{site.hours.confirmed ? site.hours.lines.join(': ') : site.hours.note}</span>
          </li>
        </ul>
        <a class="link-arrow" href="/contacto/">Ver contacto y cómo llegar <Icon name="arrow" size={18} /></a>
      </div>
      <div data-reveal style="--d:1">
        <MapEmbed />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ═════════ Hero ═════════ */
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--c-white);
    background:
      radial-gradient(70rem 40rem at 85% 10%, rgb(11 78 162 / 0.28), transparent 60%),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 6rem 100%,
      var(--c-ink-deep);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
    align-content: center;
  }
  .hero__eyebrow {
    color: #c9d2dc;
  }
  .hero__title {
    color: var(--c-white);
    max-width: 13ch;
  }
  .hero__accent {
    position: relative;
    color: #ff8a8d;
    white-space: nowrap;
  }
  .hero__accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.09em;
    background: var(--c-brand);
    transform-origin: left;
  }
  .hero__lead {
    max-width: 36rem;
    font-size: var(--fs-lg);
    color: #c9d2dc;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .hero__call {
    color: #9eabb8;
    font-size: var(--fs-sm);
  }
  .hero__call a {
    color: var(--c-white);
    font-weight: 750;
  }

  .hero__media {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 34rem;
  }
  .hero__img {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
  }
  .hero__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__media::before {
    content: '';
    position: absolute;
    inset: -1.25rem -1.25rem 1.25rem 1.25rem;
    border: 1.5px solid rgb(255 255 255 / 0.18);
    border-radius: 18px;
    z-index: -1;
  }
  .hero__media {
    isolation: isolate;
  }
  .hero__fact {
    position: absolute;
    display: grid;
    gap: 0.15rem;
    max-width: 13.5rem;
    padding: var(--s-3) var(--s-4);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.96);
    color: var(--c-ink-soft);
    font-size: var(--fs-xs);
    line-height: 1.35;
    box-shadow: var(--shadow-lg);
  }
  .hero__fact .num {
    font-size: var(--fs-xl);
    color: var(--c-ink);
  }
  .hero__fact--a {
    left: -2.5rem;
    top: 18%;
  }
  .hero__fact--b {
    right: -1.5rem;
    bottom: 12%;
  }
  .hero__credit {
    position: absolute;
    right: var(--s-3);
    top: var(--s-3);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgb(13 22 32 / 0.55);
    color: #e8edf2;
    font-size: 0.6875rem;
    font-weight: 600;
  }

  /* Accesos rápidos */
  .hero__quick {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .quick {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    column-gap: var(--s-4);
    align-items: center;
    padding: var(--s-5);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: var(--c-white);
    text-decoration: none;
    transition: background-color 0.3s var(--ease);
  }
  .quick::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 100%;
    background: var(--c-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .quick:hover {
    background: rgb(255 255 255 / 0.04);
  }
  .quick:hover::before {
    transform: scaleX(1);
  }
  .quick__n {
    grid-row: span 2;
    font-size: var(--fs-sm);
    color: #ff8a8d;
  }
  .quick__name {
    font-weight: 750;
    font-size: var(--fs-lg);
  }
  .quick__count {
    grid-column: 2;
    font-size: var(--fs-xs);
    color: #9eabb8;
  }
  .quick :global(.quick__arrow) {
    grid-row: 1 / span 2;
    grid-column: 3;
    transition: transform 0.3s var(--ease-out);
  }
  .quick:hover :global(.quick__arrow) {
    transform: translateX(4px);
  }

  /* Entrada del hero (solo CSS, sin ocultar contenido sin JS) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__text > * {
      animation: rise 0.9s var(--ease-out) both;
    }
    .hero__text > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero__text > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .hero__text > :nth-child(4) {
      animation-delay: 0.24s;
    }
    .hero__text > :nth-child(5) {
      animation-delay: 0.3s;
    }
    .hero__accent::after {
      animation: line-in 0.9s var(--ease-out) 0.5s both;
    }
    .hero__img img {
      animation: settle 1.6s var(--ease-out) both;
    }
    .hero__fact--a {
      animation: rise 0.9s var(--ease-out) 0.5s both;
    }
    .hero__fact--b {
      animation: rise 0.9s var(--ease-out) 0.65s both;
    }
    .quick {
      animation: rise 0.8s var(--ease-out) both;
      animation-delay: calc(0.45s + var(--i) * 0.08s);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }
  @keyframes line-in {
    from {
      transform: scaleX(0);
    }
  }

  /* ═════════ Catálogo (bento) ═════════ */
  .catalog__intro {
    max-width: 30rem;
    color: var(--c-ink-soft);
  }
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .tile {
    position: relative;
    display: grid;
    min-height: 19rem;
    border-radius: 14px;
    overflow: hidden;
    color: var(--c-white);
    background: var(--c-ink);
    isolation: isolate;
  }
  .tile--lg {
    grid-row: span 2;
    min-height: 34rem;
  }
  .tile__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(13 22 32 / 0) 25%, rgb(13 22 32 / 0.55) 55%, rgb(13 22 32 / 0.92) 100%);
  }
  .tile__body {
    align-self: end;
    display: grid;
    gap: var(--s-3);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .tile__count {
    font-size: var(--fs-xs);
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffb3b5;
  }
  .tile__title {
    font-size: var(--fs-2xl);
