---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { categories, productsIn, productUrl, categoryUrl, getProduct } from '../data/catalog';
import { guides } from '../data/guides';
import { site, primaryPhone, primaryEmail, fullAddress } from '../data/site';
import { localBusiness } from '../data/schema';
import heroImg from '../assets/products/sistemas-elevables.png';
import imgAluminio from '../assets/products/sistemas-abatibles.png';
import imgMateriales from '../assets/products/vidrios-acristalamientos.png';
import imgOtros from '../assets/products/toldos-pergolas.png';

const categoryImages = {
  'sistemas-aluminio': imgAluminio,
  'materiales-adicionales': imgMateriales,
  'otros-productos': imgOtros,
};

const featured = ['abatibles', 'correderas', 'elevables', 'vidrios-acristalamientos'].map((s) => getProduct(s)!);

const values = [
  {
    icon: 'calendar',
    title: `Desde ${site.foundingYear}`,
    text: 'Más de 50 años en el sector y dos generaciones de profesionales para ofrecerle la mejor solución en calidad, aislamiento térmico y precio.',
  },
  {
    icon: 'leaf',
    title: 'Ahorro energético',
    text: 'Es nuestra prioridad: le asesoramos para combinar carpinterías y vidrios de altas prestaciones y conseguir un mayor ahorro.',
  },
  {
    icon: 'shield',
    title: 'Calidad y garantía',
    text: 'Cuidamos al máximo la fabricación, con controles exhaustivos y los mejores materiales y acabados.',
  },
  {
    icon: 'chat',
    title: 'Asesoramiento sin compromiso',
    text: 'Le aconsejamos el sistema que mejor se adapta a sus necesidades antes de que tome cualquier decisión.',
  },
] as const;

const brands = [
  { name: 'QSystems', what: 'Perfiles de aluminio', href: '/sistemas-aluminio/' },
  { name: 'SGG Climalit', what: 'Vidrio y doble acristalamiento', href: '/materiales-adicionales/vidrios-acristalamientos/' },
  { name: 'Cherubini', what: 'Motores y automatismos', href: '/materiales-adicionales/domotica-automatismos/' },
  { name: 'Kassandra', what: 'Mamparas de baño', href: '/otros-productos/mamparas-bano/' },
];
---

<Base
  title="Talleres Verjano | Ventanas y carpintería de aluminio en Madrid"
  rawTitle
  description="Fabricantes e instaladores de ventanas, puertas y cerramientos de aluminio en Madrid desde 1968. Sistemas con rotura de puente térmico, vidrios, persianas y más."
  jsonLd={[localBusiness]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Carpintería de aluminio en Madrid · Desde {site.foundingYear}</p>
        <h1>Ventanas y cerramientos de aluminio fabricados a medida</h1>
        <p class="lead">
          Fabricamos e instalamos ventanas, puertas y fachadas de aluminio con rotura de puente térmico, y las completamos con vidrios, persianas y protección solar. Dos generaciones de profesionales en Vallecas.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contacto/#presupuesto">Pedir presupuesto sin compromiso</a>
          <a class="btn btn--ghost" href={primaryPhone.href}>
            <Icon name="phone" size={18} />
            Llamar al {primaryPhone.display}
          </a>
        </div>
        <ul class="hero__points">
          <li><Icon name="factory" size={20} /> Exposición y fábrica en Madrid</li>
          <li><Icon name="ruler" size={20} /> Fabricación a medida</li>
          <li><Icon name="leaf" size={20} /> Perfiles con rotura de puente térmico</li>
        </ul>
      </div>
      <div class="hero__media">
        <Image
          src={heroImg}
          alt="Gran ventanal corredero de aluminio abierto a una terraza con vistas al mar"
          widths={[480, 765]}
          sizes="(max-width: 62rem) 100vw, 560px"
          loading="eager"
          fetchpriority="high"
        />
        <p class="hero__caption">
          <span>Sistema elevable</span>
          <a href="/sistemas-aluminio/elevables/">Hojas de hasta 400 kg <Icon name="arrow" size={14} /></a>
        </p>
      </div>
    </div>
  </section>

  <!-- Catálogo -->
  <section class="section" aria-labelledby="catalogo-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Catálogo</p>
        <h2 id="catalogo-title">Todo lo que necesita su ventana, y más</h2>
        <p>Quince familias de producto organizadas en tres líneas. Cada ficha incluye la información técnica y, cuando existe, la documentación del fabricante.</p>
      </div>
      <div class="families">
        {
          categories.map((c) => (
            <article class="family">
              <a class="family__media" href={categoryUrl(c.slug)} tabindex="-1" aria-hidden="true">
                <Image src={categoryImages[c.slug]} alt="" widths={[400, 765]} sizes="(max-width: 62rem) 100vw, 380px" />
              </a>
              <div class="family__body">
                <h3>
                  <a href={categoryUrl(c.slug)}>{c.name}</a>
                </h3>
                <ul>
                  {productsIn(c.slug).map((p) => (
                    <li>
                      <a href={productUrl(p)}>{p.name}</a>
                    </li>
                  ))}
                </ul>
                <a class="link-arrow" href={categoryUrl(c.slug)}>
                  Ver {c.name.toLowerCase()}
                  <Icon name="arrow" size={18} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Diferenciadores -->
  <section class="section section--surface" aria-labelledby="valores-title">
    <div class="container values">
      <div class="section-head">
        <p class="eyebrow">Por qué Talleres Verjano</p>
        <h2 id="valores-title">Un taller con oficio y criterio técnico</h2>
      </div>
      <ul class="values__list">
        {
          values.map((v) => (
            <li class="value">
              <span class="value__icon">
                <Icon name={v.icon} size={24} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Destacados -->
  <section class="section" aria-labelledby="destacados-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Destacados</p>
          <h2 id="destacados-title">Sistemas destacados de nuestro catálogo</h2>
        </div>
        <a class="link-arrow" href="/sistemas-aluminio/">Todos los sistemas de aluminio <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid grid--4">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- Marcas -->
  <section class="section section--surface brands" aria-labelledby="marcas-title">
    <div class="container brands__inner">
      <div class="section-head">
        <p class="eyebrow">Fabricantes</p>
        <h2 id="marcas-title">Trabajamos con fabricantes de referencia</h2>
        <p>Seleccionamos perfiles, vidrios y mecanismos de marcas reconocidas y le explicamos las diferencias entre series.</p>
      </div>
      <ul class="brands__list">
        {
          brands.map((b) => (
            <li>
              <a href={b.href}>
                <span class="brands__name">{b.name}</span>
                <span class="brands__what">{b.what}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Consejos -->
  <section class="section" aria-labelledby="consejos-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Consejos</p>
          <h2 id="consejos-title">Antes de cambiar sus ventanas</h2>
        </div>
        <a class="link-arrow" href="/consejos/">Ver todos los consejos <Icon name="arrow" size={18} /></a>
      </div>
      <div class="guides">
        {
          guides.map((g) => (
            <article class="guide">
              <h3>
                <a href={`/consejos/${g.slug}/`}>{g.title}</a>
              </h3>
              <p>{g.excerpt}</p>
              <span class="guide__more" aria-hidden="true">
                Leer guía <Icon name="arrow" size={16} />
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section class="section section--dark" aria-labelledby="visitenos-title">
    <div class="container visit">
      <div class="visit__text">
        <p class="eyebrow">Contacto</p>
        <h2 id="visitenos-title">Visite nuestra exposición y fábrica</h2>
        <ul class="visit__list">
          <li>
            <Icon name="pin" size={20} />
            <span>{fullAddress} <span class="visit__muted">({site.address.district})</span></span>
          </li>
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={20} />
                <a href={p.href}>
                  {p.display} <span class="visit__muted">· {p.label.toLowerCase()}</span>
                </a>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={20} />
            <a href={`mailto:${primaryEmail.address}`}>{primaryEmail.address}</a>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <span>
              {site.hours.lines.join(': ')}
              {!site.hours.confirmed && <span class="visit__muted visit__note">{site.hours.note}</span>}
            </span>
          </li>
        </ul>
        <div class="visit__actions">
          <a class="btn btn--primary" href="/contacto/#presupuesto">Pedir presupuesto</a>
          <a class="btn btn--outline-light" href="/contacto/">Ver contacto</a>
        </div>
      </div>
      <MapEmbed />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background:
      linear-gradient(90deg, var(--c-grid) 1px, transparent 1px) 0 0 / 6rem 100%,
      var(--c-surface);
    border-bottom: 1px solid var(--c-line);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
  }
  .hero h1 {
    font-size: var(--fs-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .hero__points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line-strong);
    font-size: var(--fs-sm);
    font-weight: 650;
    color: var(--c-ink-soft);
  }
  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .hero__points :global(svg) {
    color: var(--c-brand);
  }
  .hero__media {
    position: relative;
    margin: 0;
  }
  .hero__media img {
    width: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .hero__media::before {
    /* Marco desplazado: evoca un perfil de aluminio */
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 2px solid var(--c-brand);
    border-radius: var(--radius-lg);
    z-index: -1;
  }
  .hero__media {
    isolation: isolate;
  }
  .hero__caption {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    display: grid;
    gap: 0.1rem;
    padding: var(--s-3) var(--s-4);
    background: var(--c-white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-size: var(--fs-xs);
  }
  .hero__caption span {
    color: var(--c-muted);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__caption a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--c-ink);
    font-weight: 750;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .hero__caption a:hover {
    color: var(--c-blue);
  }

  /* Familias */
  .families {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .family {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--c-white);
  }
  .family__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .family__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .family__body {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-5) var(--s-6);
    align-content: start;
    flex: 1;
    grid-template-rows: auto 1fr auto;
  }
  .family h3 {
    font-size: var(--fs-xl);
  }
  .family h3 a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .family h3 a:hover {
    color: var(--c-blue);
  }
  .family ul {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--c-line);
    align-content: start;
  }
  .family li a {
    display: block;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .family li a:hover {
    color: var(--c-blue);
  }

  /* Valores */
  .values__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .value {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5);
    background: var(--c-white);
    border-top: 3px solid var(--c-ink);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .value__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--c-surface);
    color: var(--c-brand);
  }
  .value h3 {
    font-size: var(--fs-lg);
  }
  .value p {
    color: var(--c-ink-soft);
    font-size: var(--fs-sm);
  }

  /* Marcas */
  .brands__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--s-7);
    align-items: center;
  }
  .brands .section-head {
    margin-bottom: 0;
  }
  .brands__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .brands__list a {
    display: grid;
    gap: var(--s-1);
    height: 100%;
    padding: var(--s-6) var(--s-5);
    background: var(--c-white);
    text-decoration: none;
  }
  .brands__list a:hover .brands__name {
    color: var(--c-blue);
  }
  .brands__name {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }
  .brands__what {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  /* Consejos */
  .guides {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .guide {
    position: relative;
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-left: 4px solid var(--c-brand);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.2s var(--ease);
  }
  .guide:hover {
    box-shadow: var(--shadow-md);
  }
  .guide:focus-within {
    outline: 3px solid var(--c-blue);
    outline-offset: 2px;
  }
  .guide h3 {
    font-size: var(--fs-xl);
  }
  .guide h3 a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .guide h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .guide h3 a:focus-visible {
    outline: none;
  }
  .guide p {
    color: var(--c-ink-soft);
  }
  .guide__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--c-blue);
  }

  /* Visítenos */
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-7);
    align-items: center;
  }
  .visit__text {
    display: grid;
    gap: var(--s-5);
  }
  .visit h2 {
    font-size: var(--fs-2xl);
  }
  .visit__list {
    list-style: none;
    display: grid;
    gap: var(--s-4);
  }
  .visit__list li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--s-3);
  }
  .visit__list :global(svg) {
    margin-top: 0.15rem;
    color: #ff8a8d;
  }
  .visit__list a {
    color: var(--c-white);
    font-weight: 650;
  }
  .visit__muted {
    color: #b7c2cd;
    font-weight: 500;
  }
  .visit__note {
    display: block;
    font-size: var(--fs-sm);
  }
  .visit__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  @media (max-width: 62rem) {
    .hero__inner,
    .brands__inner,
    .visit {
      grid-template-columns: 1fr;
    }
    .hero__media {
      margin-right: 1.25rem;
    }
    .families {
      grid-template-columns: 1fr;
    }
    .family {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    }
    .family__media {
      aspect-ratio: auto;
      height: 100%;
    }
    .values__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .family {
      display: flex;
    }
    .family__media {
      aspect-ratio: 16 / 9;
    }
    .values__list,
    .guides,
    .brands__list {
      grid-template-columns: 1fr;
    }
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
