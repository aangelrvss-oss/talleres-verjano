---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import RptDiagram from '../components/RptDiagram.astro';
import { categories, productsIn, productUrl, categoryUrl, getProduct, getCategoryMedia } from '../data/catalog';
import { heroImage } from '../data/media';
import { guides } from '../data/guides';
import { site, primaryPhone, primaryEmail, fullAddress, experience } from '../data/site';
import { localBusiness } from '../data/schema';

const featured = ['abatibles', 'correderas', 'elevables'].map(
  (s) => getProduct(s)!,
);

const teasers: Record<string, string> = {
  'sistemas-aluminio': 'Ventanas, puertas y fachadas a medida con perfiles de rotura de puente térmico.',
  'materiales-adicionales': 'Vidrios, persianas, motorización y mosquiteras para completar la ventana.',
  'otros-productos': 'Forja, toldos y pérgolas, armarios, mamparas, cerrajería y estores.',
};
const tiles = categories.map((cat) => ({ cat, media: getCategoryMedia(cat.slug), count: productsIn(cat.slug).length, teaser: teasers[cat.slug] }));

const steps = [
  { title: 'Asesoramiento', text: 'Nos cuenta qué necesita y le aconsejamos el sistema de apertura, la serie de perfil y el vidrio más adecuados para su hueco.' },
  { title: 'Presupuesto sin compromiso', text: 'Le preparamos un presupuesto con la solución elegida para que decida con toda la información.' },
  { title: 'Fabricación a medida', text: 'Fabricamos la carpintería con controles exhaustivos, con los mejores materiales y acabados.' },
  { title: 'Instalación', text: 'Nuestro equipo realiza el montaje y le deja la ventana, la puerta o el cerramiento listos para usar.' },
];

const values = [
  { icon: 'calendar', title: experience.short, text: experience.text },
  { icon: 'leaf', title: 'Ahorro energético', text: 'Le asesoramos para combinar carpinterías y vidrios de altas prestaciones y conseguir un mayor ahorro.' },
  { icon: 'shield', title: 'Calidad en cada detalle', text: 'Cuidamos al máximo la fabricación, con controles exhaustivos y los mejores materiales y acabados.' },
] as const;

const brands = [
  { name: 'QSystems', what: 'Perfiles de aluminio', href: '/sistemas-aluminio/' },
  { name: 'SGG Climalit', what: 'Vidrio y doble acristalamiento', href: '/materiales-adicionales/vidrios-acristalamientos/' },
  { name: 'Cherubini', what: 'Motores y automatismos', href: '/materiales-adicionales/domotica-automatismos/' },
  { name: 'Kassandra', what: 'Mamparas de baño', href: '/otros-productos/mamparas-bano/' },
];
---

<Base
  title="Talleres Verjano | Ventanas y carpintería de aluminio en Madrid"
  rawTitle
  description="Fabricantes e instaladores de ventanas, puertas y cerramientos de aluminio en Madrid. Sistemas con rotura de puente térmico, vidrios, persianas y protección solar."
  ogImage={heroImage.src}
  jsonLd={[localBusiness]}
>
  <!-- ───────────── Hero ───────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Image
        src={heroImage.src}
        alt={heroImage.alt}
        widths={[640, 960, 1280, 1600, 2048].filter((w) => w <= heroImage.src.width)}
        sizes="(max-width: 62rem) 100vw, 52vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position:${heroImage.focus}`}
      />
      <p class="hero__credit">{heroImage.generated ? 'Imagen ilustrativa generada con IA' : 'Imagen ilustrativa'}</p>
    </div>

    <div class="hero__inner container">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">Carpintería de aluminio · Madrid</p>
        <h1 id="hero-title" class="display hero__title">
          Ventanas y cerramientos de aluminio <span class="hero__accent">a medida</span>
        </h1>
        <p class="hero__lead">
          Fabricamos e instalamos ventanas, puertas y fachadas de aluminio con rotura de puente térmico, y las completamos con vidrios, persianas y
          protección solar.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="/contacto/#presupuesto">
            Pedir presupuesto <Icon name="arrow" size={18} class="btn__arrow" />
          </a>
          <a class="hero__call" href={primaryPhone.href}>
            <Icon name="phone" size={18} />
            <span><span class="hero__call-label">o llámenos al</span> {primaryPhone.display}</span>
          </a>
        </div>
        <ul class="hero__points" aria-label="Por qué Talleres Verjano">
          <li><Icon name="check" size={16} /> Fábrica y exposición en Madrid</li>
          <li><Icon name="check" size={16} /> Perfiles QSystems con RPT</li>
          <li><Icon name="check" size={16} /> Asesoramiento sin compromiso</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────────── Catálogo ───────────── -->
  <section class="section catalog" id="catalogo" aria-labelledby="catalogo-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div data-reveal>
          <p class="eyebrow">Catálogo</p>
          <h2 id="catalogo-title" class="h-xl">Una solución para cada hueco</h2>
        </div>
        <p class="catalog__intro" data-reveal style="--d:1">
          Quince productos en tres líneas. Cada ficha reúne la información técnica y, cuando existe, la documentación del fabricante.
        </p>
      </div>

      <div class="bento">
        {
          tiles.map((t, i) => (
            <article class:list={['tile', 'zoom-trigger', { 'tile--lg': i === 0 }]} data-reveal style={`--d:${i}`}>
              <div class="tile__media zoom-wrap">
                <Image
                  src={t.media.src}
                  alt=""
                  widths={(i === 0 ? [600, 900, 1300, 1800] : [480, 720, 1000]).filter((w) => w <= t.media.src.width)}
                  sizes={i === 0 ? '(max-width: 62rem) 100vw, 58vw' : '(max-width: 62rem) 100vw, 40vw'}
                  style={`object-position:${t.media.focus}`}
                />
              </div>
              <div class="tile__body">
                <p class="tile__count">
                  {t.count} {i === 0 ? 'sistemas' : 'productos'}
                </p>
                <h3 class="tile__title">
                  <a href={categoryUrl(t.cat.slug)}>
                    {t.cat.name}
                    <Icon name="arrow" size={20} class="tile__arrow" />
                  </a>
                </h3>
                <p class="tile__text">{t.teaser}</p>
                {i === 0 && (
                  <ul class="tile__list" aria-label={`Sistemas de ${t.cat.name.toLowerCase()}`}>
                    {productsIn(t.cat.slug).map((p) => (
                      <li>
                        <a href={productUrl(p)}>{p.name}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Banda técnica: RPT ───────────── -->
  <section class="section section--ink tech" aria-labelledby="tech-title">
    <div class="container tech__grid">
      <div class="tech__text">
        <p class="eyebrow" data-reveal>Ahorro energético</p>
        <h2 id="tech-title" class="h-xl" data-reveal style="--d:1">El aislamiento empieza en el perfil</h2>
        <p class="lead" data-reveal style="--d:2">
          En los perfiles con rotura de puente térmico, unas pletinas de poliamida separan el aluminio exterior del interior y actúan como barrera: frenan la
          transmisión de frío y calor y limitan la condensación.
        </p>
        <ul class="tech__facts">
          <li data-reveal style="--d:3">
            <span class="num">62 mm</span><span>de acristalamiento máximo en la serie abatible Q87C16</span>
          </li>
          <li data-reveal style="--d:4">
            <span class="num">400 kg</span><span>por hoja en la corredera elevable Q120</span>
          </li>
          <li data-reveal style="--d:5">
            <span class="num">3</span><span>juntas de EPDM para la estanqueidad de la serie Q87C16</span>
          </li>
        </ul>
        <p class="tech__source" data-reveal style="--d:5">Datos de los catálogos técnicos de QSystems.</p>
        <a class="link-arrow link-arrow--light" href="/consejos/rotura-puente-termico/" data-reveal style="--d:6">
          Qué es la rotura de puente térmico <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="tech__diagram">
        <RptDiagram />
      </div>
    </div>
  </section>

  <!-- ───────────── Destacados ───────────── -->
  <section class="section" aria-labelledby="destacados-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div data-reveal>
          <p class="eyebrow">Sistemas de aluminio</p>
          <h2 id="destacados-title" class="h-xl">Abrir, deslizar o elevar</h2>
        </div>
        <a class="link-arrow" href="/sistemas-aluminio/" data-reveal style="--d:1">Ver los 5 sistemas <Icon name="arrow" size={18} /></a>
      </div>
      <div class="rail">
        {featured.map((p, i) => <ProductCard product={p} delay={i} />)}
      </div>
    </div>
  </section>

  <!-- ───────────── Cómo trabajamos ───────────── -->
  <section class="section section--surface process" aria-labelledby="proceso-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 id="proceso-title" class="h-xl">Del primer contacto a la instalación</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i}`}>
              <span class="step__n num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="values">
        {
          values.map((v, i) => (
            <div class="value" data-reveal style={`--d:${i}`}>
              <span class="value__icon">
                <Icon name={v.icon} size={22} />
              </span>
              <div>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Fabricantes ───────────── -->
  <section class="section brands" aria-labelledby="marcas-title">
    <div class="container brands__grid">
      <div data-reveal>
        <p class="eyebrow">Fabricantes</p>
        <h2 id="marcas-title" class="h-xl">Trabajamos con fabricantes de referencia</h2>
        <p class="brands__text">Seleccionamos perfiles, vidrios y mecanismos de marcas reconocidas y le explicamos las diferencias entre series.</p>
      </div>
      <ul class="brands__list">
        {
          brands.map((b, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a href={b.href}>
                <span class="brands__name">{b.name}</span>
                <span class="brands__what">{b.what}</span>
                <Icon name="arrow" size={18} class="brands__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── Consejos ───────────── -->
  <section class="section section--surface" aria-labelledby="consejos-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div data-reveal>
          <p class="eyebrow">Consejos</p>
          <h2 id="consejos-title" class="h-xl">Antes de cambiar sus ventanas</h2>
        </div>
        <a class="link-arrow" href="/consejos/" data-reveal style="--d:1">Ver todos los consejos <Icon name="arrow" size={18} /></a>
      </div>
      <div class="guides">
        {
          guides.map((g, i) => (
            <article class="guide" data-reveal style={`--d:${i}`}>
              <span class="guide__n num">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                <a href={`/consejos/${g.slug}/`}>{g.title}</a>
              </h3>
              <p>{g.excerpt}</p>
              <span class="guide__more" aria-hidden="true">
                Leer guía <Icon name="arrow" size={16} />
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Presupuesto ───────────── -->
  <section class="quote-band" aria-labelledby="quote-title">
    <div class="container quote-band__inner">
      <div data-reveal>
        <p class="eyebrow">Presupuesto sin compromiso</p>
        <h2 id="quote-title" class="display quote-band__title">¿Hablamos de su proyecto?</h2>
      </div>
      <div class="quote-band__side" data-reveal style="--d:1">
        <p>Cuéntenos medidas y necesidades y le asesoramos sobre el sistema, el vidrio y los complementos que mejor se adaptan a su vivienda o local.</p>
        <div class="quote-band__actions">
          <a class="btn btn--primary btn--lg" href="/contacto/#presupuesto">
            Pedir presupuesto <Icon name="arrow" size={18} class="btn__arrow" />
          </a>
          <a class="btn btn--outline-light btn--lg" href={primaryPhone.href}>
            <Icon name="phone" size={18} />
            {primaryPhone.display}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Visítenos ───────────── -->
  <section class="section visit" aria-labelledby="visitenos-title">
    <div class="container visit__grid">
      <div class="visit__text" data-reveal>
        <p class="eyebrow">Contacto</p>
        <h2 id="visitenos-title" class="h-xl">Visite nuestra exposición y fábrica</h2>
        <ul class="visit__list">
          <li>
            <Icon name="pin" size={20} />
            <span>{fullAddress} <span class="visit__muted">({site.address.district})</span></span>
          </li>
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={20} />
                <a href={p.href}>
                  {p.display} <span class="visit__muted">· {p.label.toLowerCase()}</span>
                </a>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={20} />
            <a href={`mailto:${primaryEmail.address}`}>{primaryEmail.address}</a>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <span>{site.hours.confirmed ? site.hours.lines.join(': ') : site.hours.note}</span>
          </li>
        </ul>
        <a class="link-arrow" href="/contacto/">Ver contacto y cómo llegar <Icon name="arrow" size={18} /></a>
      </div>
      <div data-reveal style="--d:1">
        <MapEmbed />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ═════════ Hero ═════════
     Texto a la izquierda sobre tinta; la foto ocupa la mitad derecha a sangre
     hasta el borde de la ventana (sin marco ni tarjeta). En móvil, la foto va
     arriba a todo el ancho y el texto debajo. */
  .hero {
    position: relative;
    display: grid;
    color: var(--c-white);
    background:
      radial-gradient(60rem 40rem at 0% 100%, rgb(11 78 162 / 0.22), transparent 60%),
      var(--c-ink-deep);
    isolation: isolate;
  }
  .hero__inner {
    display: grid;
    align-items: center;
    min-height: clamp(34rem, calc(100svh - 7rem), 46rem);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
    align-content: center;
    /* La columna de texto termina antes de la foto, sea cual sea el ancho */
    width: min(38rem, calc(50vw - max(var(--gutter), (100vw - var(--container)) / 2) - clamp(2rem, 4vw, 4rem)));
  }
  .hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 50%;
    overflow: hidden;
    background: var(--c-ink);
    z-index: -1;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__credit {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgb(13 22 32 / 0.62);
    color: #e8edf2;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .hero__eyebrow {
    color: #c9d2dc;
  }
  .hero__title {
    color: var(--c-white);
    max-width: 14ch;
    font-size: clamp(2.5rem, 1.4rem + 3.4vw, 4.5rem);
  }
  .hero__accent {
    position: relative;
    color: #ff8a8d;
    white-space: nowrap;
  }
  .hero__accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background: var(--c-brand);
    transform-origin: left;
  }
  .hero__lead {
    max-width: 34rem;
    font-size: var(--fs-lg);
    color: #c9d2dc;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-2);
  }
  .hero__call {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    color: var(--c-white);
    font-weight: 750;
    text-decoration: none;
  }
  .hero__call:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .hero__call :global(svg) {
    color: #9eabb8;
  }
  .hero__call-label {
    color: #9eabb8;
    font-weight: 500;
  }
  .hero__points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: var(--fs-sm);
    color: #c9d2dc;
  }
  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .hero__points :global(svg) {
    color: #7fd1a3;
  }

  /* Entrada del hero (solo CSS; sin JS el contenido se ve igual) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__text > * {
      animation: rise 0.8s var(--ease-out) both;
    }
    .hero__text > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .hero__text > :nth-child(3) {
      animation-delay: 0.12s;
    }
    .hero__text > :nth-child(4) {
      animation-delay: 0.18s;
    }
    .hero__text > :nth-child(5) {
      animation-delay: 0.24s;
    }
    .hero__accent::after {
      animation: line-in 0.8s var(--ease-out) 0.45s both;
    }
    /* Solo escala: la imagen LCP se pinta desde el primer fotograma */
    .hero__media img {
      animation: settle 1.8s var(--ease-out) both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes line-in {
    from {
      transform: scaleX(0);
    }
  }

  /* ═════════ Catálogo (1 principal + 2 secundarias) ═════════ */
  .catalog__intro {
    max-width: 30rem;
    color: var(--c-ink-soft);
  }
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(17rem, 1fr));
    gap: var(--s-5);
  }
  .tile {
    position: relative;
    display: grid;
    border-radius: var(--radius-lg, 14px);
    overflow: hidden;
    color: var(--c-white);
    background: var(--c-ink);
    isolation: isolate;
  }
  .tile--lg {
    grid-row: span 2;
    min-height: 36rem;
  }
  .tile__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* El texto va sobre la mitad inferior: degradado suficiente para fotos claras (pérgola blanca) */
    background: linear-gradient(180deg, rgb(13 22 32 / 0) 20%, rgb(13 22 32 / 0.72) 55%, rgb(13 22 32 / 0.94) 100%);
  }
  /* Tarjetas secundarias: el texto ocupa más altura relativa; el degradado empieza antes
     para que el contador (texto pequeño) mantenga 4,5:1 sobre las zonas claras de la foto */
  .tile:not(.tile--lg)::after {
    background: linear-gradient(180deg, rgb(13 22 32 / 0.15) 0%, rgb(13 22 32 / 0.8) 42%, rgb(13 22 32 / 0.95) 100%);
  }
  .tile__body {
    align-self: end;
    display: grid;
    gap: var(--s-2);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .tile__count {
    font-size: var(--fs-xs);
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c9d2dc;
  }
  .tile__title {
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
  }
  .tile--lg .tile__title {
    font-size: var(--fs-2xl);
  }
  .tile__title a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: inherit;
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable; los enlaces de la lista quedan por encima */
  .tile__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tile__title a:focus-visible {
    outline: none;
  }
  .tile:has(.tile__title a:focus-visible) {
    outline: 3px solid var(--c-white);
    outline-offset: -6px;
  }
  .tile :global(.tile__arrow) {
    flex: none;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .tile:hover :global(.tile__arrow) {
    transform: translateX(5px);
  }
  .tile__text {
    max-width: 32rem;
    color: #d5dce3;
    font-size: var(--fs-sm);
  }
  .tile__list {
    position: relative;
    z-index: 2;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.2);
    font-size: var(--fs-sm);
  }
  .tile__list li:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-inline: var(--s-3);
