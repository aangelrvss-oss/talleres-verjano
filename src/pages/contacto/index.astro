---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import Icon from '../../components/Icon.astro';
import { site, fullAddress, primaryPhone, primaryEmail } from '../../data/site';
import { localBusiness } from '../../data/schema';

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Contacto', href: '/contacto/' },
];
---

<Base
  title="Contacto y presupuesto sin compromiso"
  description="Pida presupuesto sin compromiso a Talleres Verjano: 91 303 87 75, info@talleresverjano.com. Exposición y fábrica en C/ Cerámica 25, P.I. La Cerámica, 28038 Madrid."
  breadcrumbs={breadcrumbs}
  jsonLd={[localBusiness]}
>
  <PageHero
    title="Hablemos de su proyecto"
    eyebrow="Contacto"
    lead="Llámenos, escríbanos o visite nuestra exposición y fábrica. Si nos cuenta qué necesita, le preparamos un presupuesto sin compromiso."
    breadcrumbs={breadcrumbs}
  />

  <section class="quick-contact" aria-label="Formas de contacto">
    <div class="container quick-contact__grid">
      <a class="qc" href={primaryPhone.href} data-reveal>
        <span class="qc__icon"><Icon name="phone" size={22} /></span>
        <span class="qc__label">Llámenos</span>
        <span class="qc__value">{primaryPhone.display}</span>
        <span class="qc__hint">Móvil: {site.phones[1].display}</span>
      </a>
      <a class="qc" href={`mailto:${primaryEmail.address}`} data-reveal style="--d:1">
        <span class="qc__icon"><Icon name="mail" size={22} /></span>
        <span class="qc__label">Escríbanos</span>
        <span class="qc__value qc__value--sm">{primaryEmail.address}</span>
        <span class="qc__hint">Atención a clientes: {site.emails[1].address}</span>
      </a>
      <a class="qc" href={site.mapsUrl} target="_blank" rel="noopener" data-reveal style="--d:2">
        <span class="qc__icon"><Icon name="pin" size={22} /></span>
        <span class="qc__label">{site.address.label}</span>
        <span class="qc__value qc__value--sm">{site.address.street}, {site.address.postalCode} {site.address.city}</span>
        <span class="qc__hint">{site.address.area} · Cómo llegar<span class="visually-hidden"> (Google Maps, pestaña nueva)</span></span>
      </a>
    </div>
  </section>

  <section class="section contact-section" aria-label="Formulario de presupuesto">
    <div class="container contact">
      <div class="contact__side" data-reveal>
        <p class="eyebrow">Presupuesto</p>
        <h2 class="h-xl">Solicite presupuesto sin compromiso</h2>
        <p class="contact__intro">Rellene el formulario y le responderemos a la mayor brevedad por teléfono o por correo, según prefiera.</p>
        <ul class="contact__points">
          <li><Icon name="check" size={18} /> Solo le pedimos los datos necesarios para responderle.</li>
          <li><Icon name="check" size={18} /> Si viene desde una ficha, el producto ya estará seleccionado.</li>
          <li><Icon name="check" size={18} /> {site.hours.confirmed ? `Horario: ${site.hours.lines.join(', ')}.` : site.hours.note}</li>
        </ul>
      </div>
      <div class="contact__form" id="presupuesto" data-reveal style="--d:1">
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="mapa-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cómo llegar</p>
        <h2 id="mapa-title" class="h-xl">Exposición y fábrica en Vallecas</h2>
        <p>{fullAddress} ({site.address.district}).</p>
      </div>
      <div data-reveal style="--d:1">
        <MapEmbed />
      </div>
    </div>
  </section>
</Base>

<style>
  .quick-contact {
    position: relative;
    z-index: 1;
    margin-top: -2.5rem;
  }
  .quick-contact__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .qc {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    padding: var(--s-5);
    background: var(--c-white);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    color: var(--c-ink);
    text-decoration: none;
    transition: transform 0.35s var(--ease-out);
  }
  @media (hover: hover) {
    .qc:hover {
      transform: translateY(-4px);
    }
  }
  .qc__icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--s-2);
    border-radius: 50%;
    background: #fde7e8;
    color: var(--c-brand-dark);
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .qc:hover .qc__icon {
    background: var(--c-brand);
    color: var(--c-white);
  }
  .qc__label {
    font-size: var(--fs-xs);
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .qc__value {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .qc__value--sm {
    font-size: var(--fs-lg);
  }
  .qc__hint {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
    overflow-wrap: anywhere;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .contact__side {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .contact__intro {
    color: var(--c-ink-soft);
    font-size: var(--fs-lg);
  }
  .contact__points {
    list-style: none;
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .contact__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    color: var(--c-ink-soft);
  }
  .contact__points :global(svg) {
    margin-top: 0.2rem;
    color: var(--c-success);
  }
  .contact__form {
    padding: clamp(1.25rem, 4vw, 2.75rem);
    border-radius: 18px;
    background: var(--c-white);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-lg);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  @media (max-width: 62rem) {
    .quick-contact {
      margin-top: var(--s-5);
    }
    .quick-contact__grid,
    .contact {
      grid-template-columns: 1fr;
    }
    .contact__side {
      position: static;
    }
  }
</style>
