---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { categories, productsIn, categoryUrl } from '../data/catalog';
import { site, fullAddress, experience } from '../data/site';
import img from '../assets/products/sistemas-correderas.png';
import heroImg from '../assets/stock/fachada-ventanas-aluminio.jpg';

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'La empresa', href: '/empresa/' },
];

const pillars = [
  {
    icon: 'calendar',
    title: experience.short,
    text: experience.text,
  },
  {
    icon: 'leaf',
    title: 'Ahorro energético',
    text: 'Es nuestra prioridad. Le asesoramos para combinar sistemas de carpintería y vidrios de altas prestaciones y obtener un mayor ahorro energético.',
  },
  {
    icon: 'shield',
    title: 'Calidad en cada detalle',
    text: 'Cuidamos al máximo la fabricación, con controles exhaustivos para que nuestros trabajos sean de la más alta calidad y con los mejores materiales y acabados.',
  },
] as const;
---

<Base
  title="La empresa: carpintería de aluminio en Madrid"
  description="Talleres Verjano: dos generaciones fabricando e instalando carpintería de aluminio en Madrid. Exposición y fábrica en el P.I. La Cerámica (Vallecas)."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title="Dos generaciones dedicadas a la carpintería de aluminio"
    eyebrow="La empresa"
    lead={`${site.name} fabrica e instala ventanas, puertas y cerramientos en Madrid${site.foundingYearConfirmed ? ` desde ${site.foundingYear}` : ''}. Nuestra exposición y fábrica está en el Polígono Industrial La Cerámica, en Puente de Vallecas.`}
    breadcrumbs={breadcrumbs}
    image={heroImg}
    imageAlt="Ventanas de aluminio proyectantes en una fachada"
    imageCaption="Imagen ilustrativa."
  />

  <section class="section">
    <div class="container about">
      <div class="prose about__text" data-reveal>
        <h2>Fabricantes e instaladores</h2>
        <p>
          Somos fabricantes e instaladores de carpintería de aluminio. Trabajamos con perfiles de QSystems, empresa española de referencia, y con vidrios SGG Climalit, y completamos cada proyecto con persianas, automatismos, mosquiteras y protección solar.
        </p>
        <p>
          Además de ventanas y puertas, realizamos trabajos de muro cortina, hierro y forja, toldos, frentes de armario, mamparas de baño y cerrajería de seguridad, de modo que puede resolver con un solo proveedor buena parte de los cerramientos de su vivienda, local u oficina.
        </p>
        <h2>Asesoramiento personalizado</h2>
        <p>
          Cada hueco es distinto. Nuestros técnicos le asesoran sobre el sistema de apertura, la serie de perfil y la composición del vidrio más adecuados teniendo en cuenta la orientación, el viento y el ruido de la zona. Le aconsejamos sin compromiso.
        </p>
      </div>
      <figure class="about__media" data-reveal="image">
        <Image src={img} alt="Corredera de aluminio de gran formato en un salón luminoso" widths={[480, 765]} sizes="(max-width: 62rem) 100vw, 520px" />
        <figcaption>Imagen ilustrativa.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="valores-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Nuestros valores</p>
        <h2 id="valores-title" class="h-xl">Lo que nos define</h2>
      </div>
      <ul class="pillars">
        {
          pillars.map((p, i) => (
            <li data-reveal style={`--d:${i}`}>
              <Icon name={p.icon} size={28} />
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="que-hacemos-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Qué hacemos</p>
        <h2 id="que-hacemos-title" class="h-xl">Nuestras líneas de producto</h2>
      </div>
      <ul class="lines">
        {
          categories.map((c, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a href={categoryUrl(c.slug)}>
                <span class="lines__name">{c.name}</span>
                <span class="lines__items">{productsIn(c.slug).map((p) => p.name).join(' · ')}</span>
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="visit">
        <Icon name="pin" size={20} />
        <span><strong>{site.address.label}:</strong> {fullAddress}.</span>
        <a href="/contacto/">Cómo llegar</a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .about__media {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }
  .about__media img {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .about__media figcaption {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .pillars {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .pillars li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-6) var(--s-5);
    background: var(--c-white);
    border-top: 3px solid var(--c-ink);
    border-radius: 0 0 12px 12px;
    box-shadow: var(--shadow-sm);
  }
  .pillars :global(svg) {
    color: var(--c-blue);
  }
  .pillars h3 {
    font-size: var(--fs-lg);
  }
  .pillars p {
    color: var(--c-ink-soft);
  }
  .lines {
    list-style: none;
    border-top: 1px solid var(--c-line);
  }
  .lines a {
    display: grid;
    grid-template-columns: minmax(12rem, 0.6fr) 1fr auto;
    gap: var(--s-5);
    align-items: center;
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-ink);
    text-decoration: none;
  }
  .lines a {
    transition: padding-left var(--dur-ui) var(--ease-out);
  }
  .lines a:hover {
    padding-left: var(--s-3);
  }
  .lines a:hover .lines__name {
    color: var(--c-blue);
  }
  .lines__name {
    font-size: var(--fs-xl);
    font-weight: 800;
  }
  .lines__items {
    color: var(--c-ink-soft);
    font-size: var(--fs-sm);
  }
  .visit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    align-items: center;
    margin-top: var(--s-6);
    color: var(--c-ink-soft);
  }
  .visit :global(svg) {
    color: var(--c-ink-soft);
  }
  .visit a {
    font-weight: 700;
  }
  @media (max-width: 62rem) {
    .about,
    .pillars {
      grid-template-columns: 1fr;
    }
    .lines a {
      grid-template-columns: 1fr auto;
    }
    .lines__items {
      grid-column: 1;
    }
  }
</style>
